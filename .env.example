# Copy to .env and change as needed. Every value has a working default in docker-compose.yml.
POSTGRES_DB=grammap
POSTGRES_USER=grammap
POSTGRES_PASSWORD=grammap

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Host ports
DB_PORT=5432
BACKEND_PORT=8000
TILES_PORT=3000
FRONTEND_PORT=5173

# Your user and group id (`id -u`, `id -g`), so files the containers create are yours
HOST_UID=1000
HOST_GID=1000
